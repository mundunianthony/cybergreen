# Formspree form IDs. Create two forms at https://formspree.io and paste each form's ID
# (the part after /f/ in https://formspree.io/f/abcdwxyz) or the full endpoint URL.
# These are NOT secrets: Formspree endpoints are always visible in the page source.
# Leave them empty to keep the original behaviour (forms only prepare a WhatsApp/email message).
PUBLIC_FORMSPREE_CONTACT_ID=
PUBLIC_FORMSPREE_PICKUP_ID=
