---
import { anchors, routes } from "../data/site";
import Arrow from "./Arrow.astro";
import styles from "./CtaBand.module.css";
---

<section class={styles.cta}>
  <div class:list={["wrap", styles.inner]}>
    <div>
      <h2>Old electronics to clear, or a school to train?</h2>
      <p>Tell us what you have and where you are. We reply within one working day.</p>
    </div>
    <div class="btns">
      <a class="btn btn-copper" href={`${routes.ewaste}#${anchors.pickup}`}>
        Request a pickup <Arrow />
      </a>
      <a class="btn btn-line" href={routes.contact}>
        Talk to us
      </a>
    </div>
  </div>
</section>
